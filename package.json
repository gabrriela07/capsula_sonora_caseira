{
  "name": "capsula-sonora-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,SITE --prefix-colors yellow,cyan \"npm run dev:api\" \"npm run dev:site\"",
    "dev:api": "npm run dev --prefix server",
    "dev:site": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "sync": "npm --prefix server run sync"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
