# Copie para server/.env e preencha. Não suba o .env para o GitHub.

# MySQL (o banco precisa existir; veja schema.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=capsula_sonora

# Last.fm (a chave fica só no servidor)
VITE_LASTFM_API_KEY=5e67e899ec267c47ff4d572fe4c1e3bd
VITE_LASTFM_USER=s0ucient

# Porta do servidor. Acesse pelo celular em http://IP_DO_SERVIDOR:3001
PORT=3001

# Senha de acesso ao painel (qualquer usuário + esta senha). Vazio = sem senha.
APP_PASSWORD=

# Fuso usado para gravar a data/hora local de cada scrobble
TZ_LOCAL=America/Sao_Paulo

# Intervalo da sincronização automática, em minutos
SYNC_INTERVAL_MINUTES=60
