# ============================================================
# Cápsula Sonora — copie este arquivo para server/.env
# Em produção (Render etc.), cadastre as mesmas chaves no painel
# ============================================================

# --- Last.fm (servidor) -------------------------------------
# Crie sua chave em https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Opcional: usuário aberto quando ninguém informa outro (?user=)
LASTFM_USER=
# Opcional: restringe a instalação a alguns usuários (separados por vírgula)
ALLOWED_USERS=

# --- MySQL -------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=capsula_sonora
# true para bancos na nuvem (Aiven, TiDB…)
MYSQL_SSL=false

# --- Aplicação ---------------------------------------------
# Vazia = acesso livre; preenchida = o navegador pede senha
APP_PASSWORD=
SYNC_INTERVAL_MINUTES=60
TZ_LOCAL=America/Sao_Paulo

# --- Frontend (Vite) — ficam visíveis no navegador ---------
# Usadas para buscar capas e fotos. Nunca coloque senhas aqui.
VITE_LASTFM_API_KEY=
VITE_LASTFM_USER=
